[Unit]
Description=Проверять реестр образов каждые 5 минут

[Timer]
# Первая проверка через минуту после загрузки — чтобы сервер догонял
# репозиторий и после перезагрузки, а не только по расписанию.
OnBootSec=1min
OnUnitActiveSec=5min
# Разброс: если однажды появятся ещё серверы, они не пойдут в реестр разом.
RandomizedDelaySec=30
AccuracySec=30s

[Install]
WantedBy=timers.target
