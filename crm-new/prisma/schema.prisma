/// Настройки расчёта с партнёром-исполнителем (печать футболок).
/// Одна строка на систему; правится администратором. Значения по умолчанию
/// подставляются в новую позицию, но в самой позиции их можно переопределить.
model PartnerSettings {
  id        String   @id @default("default")
  updatedAt DateTime @updatedAt

  thermalTransferCost    Int    @default(70)
  blankTshirtCost        Int    @default(260)
  // Доля партнёра от маржи в сотых процента: 3000 = 30%.
  partnerRateBasisPoints Int    @default(3000)
  partnerName            String @default("Партнёр")

  // Шаблон ссылки на переписку в MAX: менеджер вводит телефон, CRM собирает
  // ссылку. {phone} — только цифры (79991234567), {phone_plus} — с плюсом.
  // Вынесен в настройки, чтобы поправить формат без правки кода и деплоя.
  maxLinkTemplate String @default("https://max.ru/{phone}")

  // Себестоимость фотопечати. Задаём коробкой, а не ценой листа: коробку
  // покупают, цену листа считают. 800 ₽ за 500 листов = 1,6 ₽ за лист.
  // Захотите учесть чернила — поднимите цену коробки, код менять не нужно.
  photoBoxCost      Int @default(800)
  photoSheetsPerBox Int @default(500)

  // Сколько платим перевозчику. Клиенту называем больше (обычно 300 ₽), и
  // разница — заработок, а не транзит: прежний отчёт вычитал доставку
  // целиком и терял эти деньги.
  deliveryCostYandexPvz Int @default(99)
  deliveryCostOzonPvz   Int @default(140)

  // Условия производства по холсту. Прайс лежит в коде
  // (canvas/canvas-production-price.ts) — он приходит файлом и меняется целиком.
  // А вот договорённости меняются переговорами, поэтому живут здесь: скоро
  // производство даст оптовые цены, и скидка поедет без правки кода.
  //
  // Скидка в сотых процента, как ставка партнёра: 2000 = 20%.
  canvasDiscountBasisPoints Int @default(2000)
  // Своя доставка производства в пределах Москвы: сколько платим и сколько
  // называем клиенту. Разница — заработок, а не транзит.
  canvasDeliveryCost        Int @default(700)
  canvasDeliveryPrice       Int @default(800)

  // Кого всегда тегать в общем чате при заявке с сайта. Через запятую,
  // с собакой или без. Владелец видит заявки лично, не назначая себя
  // менеджером по оформлению и не отбирая заявки у того, кто их ведёт.
  leadMentionUsernames String @default("")
}

/// Задача из планировщика. Ставит администратор, выполняет исполнитель.
/// Напоминания уходят в рабочий чат раз в день, пока задача не закрыта.
model Task {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  title       String
  description String?
  status      EnumTaskStatus @default(OPEN)

  /// Срок необязателен: без него задача живёт в списке, но не пингует в чат.
  deadline    DateTime?
  completedAt DateTime?

  assigneeId String
  assignee   User   @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)

  createdById String
  createdBy   User   @relation("TaskAuthor", fields: [createdById], references: [id])

  /// Необязательная привязка к заказу — «переделать макет к 202607-015».
  orderId String?
  order   OrderPhoto? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  /// Сколько стоит выполнение задачи. 0 — задача без оплаты.
  /// При переводе в «Выполнена» сотруднику начисляется эта сумма.
  rewardAmount Int @default(0)

  /// Начисление, созданное за выполнение. Хранится, чтобы повторное закрытие
  /// задачи не начислило деньги второй раз, а откат — снял начисление.
  rewardAccrualId String?

  /// Дата последнего дайджеста (YYYY-MM-DD по Москве). Защищает от повторной
  /// отправки, если контейнер перезапустился в тот же день.
  lastRemindedOn String?

  @@index([assigneeId, status])
  @@index([status, deadline])
}

enum EnumTaskStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

/// Одна строка на всю систему для флагов планировщиков. Нужна, чтобы
/// ежедневные рассылки (например, план дня) не повторялись при рестарте
/// контейнера: храним дату последней отправки по Москве (YYYY-MM-DD).
model AppState {
  id                  String   @id @default("default")
  updatedAt           DateTime @updatedAt
  dailyPlanLastSentOn String?

  // «Старший дня» по отгрузкам: кого тегать в плане дня, чтобы он оформил
  // поставки по готовым фотозаказам и проконтролировал отгрузку. Обычно админ
  // или менеджер по оформлению. SetNull: удаление пользователя не ломает флаг.
  shipmentLeadUserId String?
  shipmentLead       User?   @relation("ShipmentLead", fields: [shipmentLeadUserId], references: [id], onDelete: SetNull)
}

model GulianOutbox {
  id              String    @id @default(uuid())
  eventId         String    @unique
  eventType       String    @default("order.upsert")
  aggregateId     String
  externalOrderId String
  sourceRevision  Int
  payloadJson     Json
  status          String    @default("pending")
  attempts        Int       @default(0)
  nextAttemptAt   DateTime  @default(now())
  lastAttemptAt   DateTime?
  deliveredAt     DateTime?
  lastError       String?
  responseCode    Int?
  responseBody    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status, nextAttemptAt])
  @@index([aggregateId])
}

/// Сторона печати в согласовании. Отдельно от EnumPrintLocation намеренно:
/// там значения производственные (рукава, «по ТЗ», full), а мокап бывает
/// только с одной стороны — перед или спина.
enum EnumApprovalSide {
  FRONT
  BACK
}

/// Состояние конкретной версии согласования. Не дублирует статус заказа:
/// EnumStatus.APPROVAL_SENT говорит «заказ ждёт ответа клиента», а здесь
/// видно, что именно случилось с этой версией макета.
enum EnumApprovalStatus {
  /// Черновик: сотрудник ещё двигает принт, файл не сформирован.
  DRAFT
  /// Нажата «Готово», PNG сформирован и лежит в заказе.
  READY
  /// Версия ушла клиенту.
  SENT
  /// Клиент подтвердил — печатаем именно это.
  APPROVED
  /// Клиент попросил переделать; следующая версия создаётся копированием.
  CHANGES_REQUESTED
}

/// Шаблон мокапа: реальная фотография изделия плюс калибровка зоны печати.
///
/// Лежит в базе, а не в коде, потому что фотографии — расходный материал:
/// их переснимают, меняют модель футболки, добавляют худи. Всё это должно
/// делаться из настроек CRM, без пересборки образа.
///
/// Калибровка — пара «зона печати в пикселях фотографии» и «её реальный
/// размер». Из неё выводится масштаб: сколько пикселей приходится на
/// миллиметр. Без этой пары «28 × 35 см» осталось бы просто подписью.
model MockupTemplate {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Устойчивый ключ («tshirt_black_front»). Согласование ссылается на него,
  /// поэтому замена фотографии не рвёт связь со старыми версиями.
  key         String           @unique
  title       String
  garmentType String           @default("tshirt")
  /// Цвет изделия строкой, как в позициях заказа: «Чёрный», «Белый».
  color       String
  side        EnumApprovalSide

  /// Имя файла фотографии в UPLOAD_DIR/mockups. Пусто — шаблон заведён, но
  /// фотографию ещё не загрузили: в редакторе он показывается как незаполненный.
  imageFile   String?
  imageWidth  Int?
  imageHeight Int?

  // Зона печати в пикселях исходной фотографии.
  printAreaX      Int @default(0)
  printAreaY      Int @default(0)
  printAreaWidth  Int @default(0)
  printAreaHeight Int @default(0)

  // Реальный размер той же зоны. В миллиметрах, а не в сантиметрах с дробью:
  // целые числа не накапливают ошибку округления при пересчёте в пиксели.
  printAreaWidthMm  Int @default(400)
  printAreaHeightMm Int @default(500)

  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  @@index([isActive, sortOrder])
}

/// Согласование печати: версия макета футболки, которую показывают клиенту.
///
/// Версии не перезаписываются и не удаляются автоматически — по ним видно,
/// что именно подтвердил клиент, если на производстве возникнет спор.
model PrintApproval {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order   OrderPhoto @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId String

  /// Номер версии в пределах заказа, с единицы.
  version Int
  status  EnumApprovalStatus @default(DRAFT)

  /// Цвет и размер футболки — строкой и перечислением, как в ItemTshirt.
  shirtColor String
  shirtSize  EnumTshirtSize
  comment    String?

  /// Размещение принта по сторонам: { "FRONT": {...}, "BACK": {...} }.
  /// Стороны независимы (свой файл, свой размер, своё положение), любая
  /// может отсутствовать. Хранится JSON, потому что читается всегда целиком
  /// и по отдельным сторонам не ищется. Разбор — approval-state.ts.
  sides Json @default("{}")

  /// Готовый лист согласования (PNG) в UPLOAD_DIR/approvals. Пусто у черновика.
  previewFile String?
  finalizedAt DateTime?

  createdById String?
  createdBy   User?   @relation("ApprovalAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([orderId, version])
  @@index([orderId])
}

// ── Генератор главных фото карточек Ozon ──────────────────────────────────

/// Состояние пачки генерации.
enum EnumCardBatchStatus {
  /// Файлы загружаются, генерация ещё не запускалась.
  DRAFT
  /// Идёт растеризация и автоматическое размещение.
  PROCESSING
  /// Все карточки посчитаны, сотрудник проверяет сетку.
  REVIEW
  /// Идёт финальный рендер в полном разрешении.
  FINALIZING
  COMPLETED
  FAILED
}

/// Состояние одного загруженного исходника.
enum EnumSourceAssetStatus {
  PENDING
  PROCESSING
  READY
  ERROR
}

/// Состояние одной карточки (исходник × цвет футболки).
enum EnumGeneratedCardStatus {
  /// Автоматическое размещение отработало, вопросов нет.
  GENERATED
  /// Дизайн сомнительный (пропорции, разрешение, контраст) — нужен глаз.
  REVIEW_REQUIRED
  APPROVED
  /// Финальный PNG собран и прошёл проверку требований Ozon.
  FINALIZED
  ERROR
  SKIPPED
}

/// Шаблон карточки: готовая композиция с футболкой, фоном и инфографикой.
///
/// Модуль ничего не рисует поверх шаблона, кроме принта, — инфографика уже
/// внутри картинки. Область размещения задаётся отдельно для каждого шаблона:
/// у чёрной и белой футболки композиция может не совпадать, и предполагать
/// обратное нельзя.
model ImageCardTemplate {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  title String
  /// Цвет изделия ключом: black, white. Строкой, а не перечислением, чтобы
  /// новый цвет добавлялся строкой в таблице, а не миграцией.
  shirtColor String

  /// Имя файла шаблона в UPLOAD_DIR/ozon-templates.
  templateFile String?
  canvasWidth  Int     @default(0)
  canvasHeight Int     @default(0)

  /// Куда ложится принт, в пикселях шаблона: { x, y, width, height }.
  placementArea Json @default("{}")
  /// Необязательная «безопасная» рамка внутри области размещения.
  safeArea      Json?

  /// Растёт при каждой замене картинки или области. Старые файлы не удаляются:
  /// на них ссылаются снимки в уже сгенерированных карточках.
  version Int     @default(1)
  active  Boolean @default(true)

  cards ImageCardGenerated[]

  @@index([active, shirtColor])
}

/// Пачка генерации: один заход «загрузил файлы — получил карточки».
model ImageCardBatch {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  title  String
  status EnumCardBatchStatus @default(DRAFT)

  /// Настройки захода: режим (BLACK/WHITE/BOTH), выбранные шаблоны,
  /// удалять ли белый фон, включено ли автоматическое размещение.
  settings Json @default("{}")

  createdById String?
  createdBy   User?   @relation("ImageCardBatchAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  completedAt DateTime?

  sources ImageCardSource[]
  cards   ImageCardGenerated[]

  @@index([status])
  @@index([createdAt])
}

/// Один загруженный исходник: PDF или картинка.
model ImageCardSource {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  batchId String
  batch   ImageCardBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  /// Как файл назывался у человека. Хранится отдельно от имени на диске:
  /// имя на диске всегда придумывает сервер.
  originalName String
  /// Очищенное имя для итоговых файлов: «JDM Skyline.pdf» → «jdm-skyline».
  baseName     String
  /// pdf | png | jpeg | webp — что пришло на вход.
  sourceType   String

  sourceFile String
  /// Растр первой страницы PDF либо нормализованная копия картинки.
  /// Именно он идёт в композит, а не исходник.
  rasterFile String?
  widthPx    Int     @default(0)
  heightPx   Int     @default(0)
  hasAlpha   Boolean @default(false)

  status       EnumSourceAssetStatus @default(PENDING)
  errorMessage String?

  cards ImageCardGenerated[]

  @@index([batchId, status])
}

/// Одна карточка: исходник, наложенный на шаблон одного цвета.
model ImageCardGenerated {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  batchId String
  batch   ImageCardBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  sourceId String
  source   ImageCardSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  templateId String
  template   ImageCardTemplate @relation(fields: [templateId], references: [id])

  /// Снимок шаблона на момент генерации: файл, размеры холста и область
  /// размещения. Благодаря ему замена шаблона не меняет внешний вид старых
  /// пачек — карточка рисуется тем, чем её собирали, а не текущей версией.
  templateSnapshot Json @default("{}")

  shirtColor String
  status     EnumGeneratedCardStatus @default(GENERATED)

  /// Положение принта в долях области размещения: { x, y, scale, rotation }.
  /// Нормализованно, а не в пикселях браузера: карточка должна одинаково
  /// собираться и в предпросмотре, и в финальном рендере любого размера.
  transform Json @default("{}")

  removeWhiteBackground Boolean @default(false)

  previewFile String?
  finalFile   String?
  /// Что показала проверка требований Ozon: размеры, вес, формат.
  validation  Json?
  /// Почему карточка помечена как требующая проверки либо ошибочная.
  note        String?

  @@index([batchId, status])
  @@index([sourceId])
}
