generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String   @id @default(uuid())
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  username              String   @unique
  password              String
  role                  EnumRole @default(EXECUTOR)
  isActive              Boolean  @default(true)
  rateBasisPoints       Int?
  // Ставка премии за разработку дизайна (в сотых процента). Есть только у роли
  // ORDER_MANAGER: помимо базовой ставки, менеджер получает этот процент от
  // суммы «разработка дизайна» в заказе. 4000 = 40%.
  designRateBasisPoints Int?
  telegramUsername      String?

  salaryAccruals     SalaryAccrual[]
  salaryPayments     SalaryPayment[]   @relation("SalaryPaymentExecutor")
  authorizedPayments SalaryPayment[]   @relation("SalaryPaymentAuthor")
  assignedOrders     OrderPhoto[]      @relation("OrderExecutor")
  processedOrders    OrderPhoto[]      @relation("OrderProcessedBy")
  rateHistory        UserRateHistory[]
  expenseOrders      ExpenseOrder[]
  assignedTasks      Task[]            @relation("TaskAssignee")
  authoredTasks      Task[]            @relation("TaskAuthor")
  avitoMessages      AvitoMessage[]
  shipmentLeadState  AppState[]        @relation("ShipmentLead")
  marketplaceAccounts MarketplaceAccount[] @relation("MarketplaceAccountOwner")
  printApprovals     PrintApproval[]   @relation("ApprovalAuthor")
  imageCardBatches   ImageCardBatch[]  @relation("ImageCardBatchAuthor")
  bulkStockOperations OzonStockBulkOperation[] @relation("BulkStockAuthor")
}

enum EnumRole {
  ADMIN
  EXECUTOR
  // Менеджер по оформлению заказов: те же права по заказам, что у админа, но
  // без доступа к «управляющим» разделам (склад, зарплата, отчёты, сотрудники,
  // настройки). Получает базовую ставку за оформленный заказ + премию за дизайн.
  ORDER_MANAGER
  /// Внешний продавец: пользуется только разделом «Маркетплейсы» и только
  /// своими кабинетами. Ни заказов, ни зарплаты, ни отчётов он не видит —
  /// это не сотрудник, а клиент сервиса. Отключается снятием isActive:
  /// проверка идёт на каждом запросе, поэтому доступ пропадает сразу.
  MARKETPLACE_CLIENT
}

model OrderPhoto {
  id        String   @id() @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  numberOrder              String              @unique
  sourceOrder              EnumSourceOrder
  communicationPlatform    EnumCommunication
  urlCommunication         String
  deliveryMethod           EnumDeliveryMethod
  deliveryCost             Int
  totalOrder               Int
  note                     String?
  status                   EnumStatus          @default(NEW)
  productCategory          EnumProductCategory @default(PHOTO)
  deadline                 DateTime?
  isUrgent                 Boolean             @default(false)
  // Свободная (договорная) цена: сумма позиции = её цене, количество НЕ умножается.
  isFreePrice              Boolean             @default(false)
  // Оставил ли клиент отзыв (отмечается вручную в списке заказов).
  clientReviewLeft         Boolean             @default(false)
  // Когда CRM автоматически напомнила рабочей группе попросить отзыв у клиента.
  reviewReminderNotifiedAt DateTime?
  // Когда оператор подтвердил (кнопкой в Telegram), что отправил клиенту запрос
  // отзыва, и кто именно. Отдельно от clientReviewLeft (клиент оставил отзыв).
  reviewRequestSentAt      DateTime?
  reviewRequestSentBy      String?
  // Сколько напоминаний об отгрузке уже отправлено (0..3). Сбрасывается
  // при возврате в «Отгрузка создана»: новая поставка — новый отсчёт.
  shipmentRemindersSent    Int                 @default(0)

  /// Когда клиенту с сайта ушло первое сообщение в Telegram.
  /// Пусто — ещё не здоровались; отсюда воркер и берёт очередь.
  clientGreetedAt   DateTime?
  /// Итог попытки: sent, либо причина отказа (privacy, not_found, flood).
  /// Нужен, чтобы не долбиться вечно в аккаунт, который написать нельзя.
  clientGreetStatus String?
  // Когда статус менялся в последний раз. По нему видно «зависшие» заказы:
  // updatedAt для этого не годится — он дёргается от любой правки заказа.
  statusChangedAt          DateTime?

  // Стоимость «разработка дизайна» по заказу (свободная цена, без количества).
  // Входит в totalOrder (клиент платит за неё) и служит базой премии менеджера
  // по оформлению: см. designRateBasisPoints у пользователя и SalaryAccrual.kind.
  designDevelopmentCost Int @default(0)

  // Плата за срочность. Входит в totalOrder (клиент её оплачивает и видит
  // отдельной строкой), но НЕ входит в базу зарплаты: это плата за скорость,
  // а не за продукцию. Вычитается из базы и исполнителя, и менеджера.
  urgencyFee Int @default(0)

  // Кто оформил заказ. Если это менеджер по оформлению (ORDER_MANAGER) — ему при
  // переходе в «Отправлен» начисляется зарплата (базовая ставка + премия дизайна).
  processedById String?
  processedBy   User?   @relation("OrderProcessedBy", fields: [processedById], references: [id])

  // Черновик оформления: какой сценарий ведёт менеджер и что он уже выяснил у
  // клиента. Живёт здесь, а не в браузере: переписка идёт часами, вкладку
  // закрывают, а собранное должно пережить это. После оформления заказа поля
  // остаются — по ним видно, что именно спрашивали.
  scenarioKey     String?
  scenarioAnswers Json?

  // Модель футболки — производственные данные, уходят исполнителю-партнёру.
  tshirtModel        String?
  // Путь к первому загруженному ТЗ-файлу на диске сервера. Оставлен для
  // совместимости со старыми заказами и интеграциями.
  techSpecPhotoPath  String?
  // Все загруженные ТЗ-файлы (фото/документы), которые уточняют заказ.
  techSpecPhotoPaths String[] @default([])

  // Отправка заказа исполнителю-партнёру (внешняя печать футболок).
  // externalRequestId — ключ идемпотентности запроса к партнёру.
  externalRequestId String?                @unique
  partnerSyncStatus EnumPartnerSyncStatus?
  partnerSyncError  String?
  partnerSyncAt     DateTime?

  executorId   String?
  executor     User?     @relation("OrderExecutor", fields: [executorId], references: [id])
  completedAt  DateTime?
  sentAt       DateTime?
  clientPaidAt DateTime?
  // Когда заказ ушёл в «закрытые» (Оплачен/Завершён/Отменён). Пусто у активных.
  // По этому полю список сортируется: активные сверху, закрытые — вниз.
  // Сбрасывается в null при возврате заказа в работу.
  closedAt     DateTime?

  // Telegram partner message reference
  partnerTgMessageId         Int?
  partnerTgChatId            String?

  // Gulian CRM integration
  sourceRevision             Int       @default(1)
  executorSentAt             DateTime?
  gulianSyncStatus           String?
  gulianLastAttemptAt        DateTime?
  gulianLastSyncedAt         DateTime?
  gulianLastError            String?
  gulianSettlementOrderId    Int?
  gulianSettlementOrderNumber String?
  gulianPositionId           Int?
  gulianAppliedRevision      Int?

  items          ItemPhoto[]
  tshirtItems    ItemTshirt[]
  canvasItems    ItemCanvas[]
  accruals       SalaryAccrual[]
  statusHistory  StatusHistory[]
  assignments    OrderAssignment[]
  stockMovements StockMovement[]
  tasks          Task[]
  expenses       ExpenseOrder[]
  avitoChats     AvitoChat[]
  approvals      PrintApproval[]

  @@index([status])
  @@index([executorId])
  @@index([processedById])
  @@index([createdAt])
  @@index([closedAt])
  @@index([productCategory])
  @@index([status, productCategory])
  @@index([productCategory, status, reviewReminderNotifiedAt])
}

/// Подключённый кабинет маркетплейса. Модель намеренно не «озоновская»:
/// у WB и Яндекса та же схема (пара «идентификатор кабинета + ключ»), поэтому
/// следующая площадка добавляется значением enum, а не второй таблицей.
///
/// Ключ хранится только в зашифрованном виде (`apiKeySecret`), в ответах API
/// не отдаётся никогда — наружу уходит лишь `apiKeyHint` (последние символы),
/// чтобы человек узнал свой ключ, но не смог его увести из браузера.
model MarketplaceAccount {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  marketplace EnumMarketplace
  /// Как кабинет называется у нас: «Основной магазин», «Тест».
  title       String

  /// Чей это кабинет. Пусто — кабинеты владельца, заведённые до появления
  /// внешних продавцов. Админ видит все, внешний продавец — только свои:
  /// в кабинете лежит ключ от чужого магазина, и путать их нельзя.
  ownerId String?
  owner   User?   @relation("MarketplaceAccountOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  /// Публичная часть доступа: Client-Id у Ozon.
  externalId  String
  /// Секретная часть: зашифрованный Api-Key (AES-256-GCM).
  apiKeySecret String
  /// Хвост ключа для интерфейса — «…a1b2».
  apiKeyHint   String
  isActive     Boolean @default(true)

  /// Итог последней проверки связи: когда, успешно ли, что ответила площадка.
  lastCheckAt    DateTime?
  lastCheckOk    Boolean?
  lastCheckError String?
  /// Сводка с площадки на момент проверки (товары, склады) — показываем на
  /// карточке подключения, чтобы было видно, что ключ «живой», а не просто 200.
  lastCheckInfo  Json?

  ozonCatalogTemplate OzonCatalogTemplate?
  ozonUnitEconomics   OzonUnitEconomics?
  ozonPrints          OzonPrint[]
  ozonWarehouses      OzonWarehouse[]
  ozonStockOperations OzonStockBulkOperation[]

  @@unique([marketplace, externalId])
  @@index([ownerId])
  @@index([marketplace, isActive])
}

enum EnumMarketplace {
  OZON
  WB
  YANDEX
}

/// Константы карточки товара «Футболка», общие для всего ассортимента
/// кабинета: страна, материал, состав, стиль и т.п. У продавца одна
/// категория на весь магазин, поэтому шаблон один на кабинет, а не на
/// каждый принт — иначе интерфейс превращается в тот же перегруженный
/// конструктор Ozon, от которого и уходим.
///
/// dictionary_value_id-поля — то, что реально уходит в Ozon (числовой id
/// значения словаря атрибута); Label-поля — то же самое человеку в
/// интерфейсе. Оба берутся из одного ответа attribute-values/search и
/// сохраняются парой, чтобы не резолвить их заново на каждой отправке.
model OzonCatalogTemplate {
  id                    String   @id @default(uuid())
  updatedAt             DateTime @updatedAt
  marketplaceAccountId  String   @unique
  account               MarketplaceAccount @relation(fields: [marketplaceAccountId], references: [id], onDelete: Cascade)

  descriptionCategoryId Int @default(200000933)
  typeId                Int @default(93244)

  vatRate          String  @default("Не облагается")
  needsMarkingCode Boolean @default(false)

  brandLabel               String @default("Нет бренда")
  brandDictionaryValueId   Int    @default(126745801)
  countryLabel              String?
  countryDictionaryValueId  Int?
  materialLabel             String? @default("Хлопок")
  materialDictionaryValueId Int?    @default(62174)
  materialComposition       String? @default("100% Хлопок")
  styleLabel                String? @default("Повседневный")
  styleDictionaryValueId    Int?    @default(29802)
  seasonLabel               String? @default("На любой сезон")
  seasonDictionaryValueId   Int?    @default(30937)
  careInstructions          String?
  sleeveLabel               String?
  sleeveDictionaryValueId   Int?
  necklineLabel             String?
  necklineDictionaryValueId Int?
  packageTypeLabel              String? @default("Пакет")
  packageTypeDictionaryValueId  Int?    @default(44412)
  tnvedLabel                     String? @default("Майки, фуфайки с рукавами и прочие нательные фуфайки трикотажные, из хлопчатобумажной пряжи")
  tnvedDictionaryValueId         Int?    @default(971398495)

  /// Габариты упаковки по умолчанию на каждый российский размер:
  /// { XS: { weightG, widthMm, heightMm, lengthMm }, ... }. Задаётся один
  /// раз в настройках, у конкретного варианта можно переопределить.
  sizeDimensions Json

  /// Дополнительные фото, одинаковые во всех карточках (размерная сетка,
  /// условия доставки и т.п.). Загружаются один раз и подставляются в каждый
  /// принт — от карточки к карточке меняется только главное фото.
  sharedPhotoUrls String[] @default([])

  /// Цена, с которой открывается форма нового принта. Продавец заводит
  /// карточки сессиями по одной цене (3500 за футболку, 6000 за худи), и
  /// вбивать её в каждую из полусотни карточек — лишняя работа.
  defaultPrice Int @default(1500)

  /// Остаток, который проставляется каждому варианту после того, как Ozon
  /// принял карточку. Без остатка товар в выдаче не показывается вообще:
  /// карточка создана, а купить её нельзя. 0 — не проставлять.
  defaultStock Int @default(100)

  /// «Цена до скидки» новой карточки. Уходит в Ozon, только если выше цены.
  defaultOldPrice Int @default(6000)

  /// Склады, на которые проставляется остаток после публикации карточки.
  /// Хранится warehouse_id площадки, а не ссылка на нашу строку: именно его
  /// принимает API остатков, и он переживает пересборку кэша складов.
  /// Пустой список — прежнее поведение (первый доступный склад), чтобы у тех,
  /// кто ничего не выбирал, остаток не начал вдруг уезжать на все склады.
  defaultWarehouseIds BigInt[] @default([])
}

/// Себестоимость и расходы продавца для расчёта юнит-экономики. Одни на весь
/// кабинет: у продавца один тип товара — футболка с принтом, — и стоимость
/// заготовки с нанесением одинакова для всех карточек.
///
/// Тарифы площадки (комиссия, логистика, эквайринг) здесь НЕ хранятся: они
/// свои у каждого товара и меняются на стороне Ozon, поэтому читаются из
/// API при каждом открытии карточки.
model OzonUnitEconomics {
  id                   String   @id @default(uuid())
  updatedAt            DateTime @updatedAt
  marketplaceAccountId String   @unique
  account              MarketplaceAccount @relation(fields: [marketplaceAccountId], references: [id], onDelete: Cascade)

  /// Себестоимость готового изделия — футболка с уже нанесённым принтом, ₽.
  /// Продавец считает её одной цифрой, поэтому это основное поле.
  blankCost      Int @default(380)
  /// Нанесение принта отдельной строкой — если печать считают не в составе
  /// изделия, а отдельно. Обычно 0.
  printCost      Int @default(0)
  packagingCost  Int @default(0)
  otherCost      Int @default(0)

  /// Доля возвратов, сотые процента: 500 = 5%. Каждый возврат стоит
  /// обратной логистики, поэтому она размазывается по всем продажам.
  returnRateBasisPoints  Int @default(0)
  /// Реклама, сотые процента от цены.
  advertisingBasisPoints Int @default(0)
  /// Ставка налога, сотые процента: 600 = 6%. По умолчанию 0 — продавец
  /// самозанятый и налог сейчас не платит. При НПД ставка 4% с продаж
  /// физлицам, так что поле пригодится, когда вычет закончится.
  taxBasisPoints         Int @default(0)
  /// База налога: income — УСН «доходы» (с выручки), profit — с прибыли.
  taxBase                String @default("income")

  /// Чем считать прямую логистику: Ozon отдаёт вилку min–max, и разница
  /// между ними втрое. max — осторожная оценка, на неё и ориентируемся.
  logisticsMode String @default("max")

  /// Переопределение комиссии, сотые процента. Ozon по некоторым кабинетам
  /// отдаёт процент, куда зашиты акции, и он расходится с отчётом —
  /// тогда сюда вписывают своё значение. null — берём из API.
  commissionOverrideBasisPoints Int?
}

/// Принт (дизайн) — то, что в интерфейсе Ozon называется карточкой товара:
/// одно название, одно фото, одна цена по умолчанию, но может объединять
/// несколько цветов. Группировка на карточке живёт в unionKey — атрибуте
/// Ozon «Объединить на одной карточке», одинаковом у всех вариантов принта.
model OzonPrint {
  id                   String   @id @default(uuid())
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  marketplaceAccountId String
  account              MarketplaceAccount @relation(fields: [marketplaceAccountId], references: [id], onDelete: Cascade)

  /// Внутренний код принта: "labrov-nadpis". Идёт в артикул варианта
  /// (<slug>-<размер>) и в атрибут Ozon «Название цвета» — так исторически
  /// делает продавец, чтобы отличать принты в выгрузках Ozon.
  slug           String
  name           String
  description    String?
  hashtags       String?
  mainPhotoUrl   String
  extraPhotoUrls String[] @default([])
  price          Int
  oldPrice       Int?
  gender         EnumTshirtGender @default(UNISEX)
  /// Рисунок/тематика — «Животные», «Надписи» и т.п., атрибут 9437.
  patternTags    String[] @default([])

  unionKey String @unique

  status    EnumOzonSyncStatus @default(DRAFT)
  lastError String?

  variants OzonVariant[]

  @@index([marketplaceAccountId, status])
}

/// Одна позиция цвет×размер внутри принта — то, что реально уходит в Ozon
/// как отдельный offer_id.
model OzonVariant {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  printId String
  print   OzonPrint @relation(fields: [printId], references: [id], onDelete: Cascade)

  colorLabel             String
  colorDictionaryValueId Int
  /// Латинский код цвета для артикула: «черный» → black. Хранится отдельно
  /// от подписи, потому что участвует в offer_id и не должен «поехать»,
  /// если человек позже переименует цвет.
  colorCode              String @default("")
  size                   EnumTshirtSize

  /// Главное фото именно этого цвета. У принта фото одно на всех, но
  /// футболка на снимке своего цвета: белый вариант с фотографией чёрного
  /// покупатель видит как чужой товар, а Ozon — как повод для отказа.
  /// Пусто — берётся главное фото принта.
  mainPhotoUrl  String?

  /// <принт>-<цвет>-<размер>, схема продавца: JDM-1-1-black-S.
  offerId       String @unique
  priceOverride Int?

  status        EnumOzonSyncStatus @default(DRAFT)
  ozonProductId BigInt?
  ozonSku       BigInt?
  lastError     String?

  /// Когда Ozon принял остаток по этому варианту. Пусто — остаток ещё нужно
  /// проставить. Сразу после импорта площадка отвечает «Product is not
  /// created»: товар создан не до конца и остатки не принимает, поэтому
  /// попытка повторяется фоном, пока не пройдёт.
  stockAppliedAt DateTime?
  /// Сколько раз пробовали проставить остаток. Ограничивает дожимание, чтобы
  /// безнадёжный вариант не опрашивался вечно.
  stockAttempts  Int       @default(0)

  @@unique([printId, colorLabel, size])
  @@index([printId])
}

/// Склад продавца в кабинете Ozon — снимок ответа /v2/warehouse/list.
///
/// Список держим у себя, а не спрашиваем при каждом открытии окна: он
/// меняется раз в месяцы, а окно массового изменения остатков открывают
/// десятки раз в день. Заодно это единственный способ показать человеку
/// «склады обновлены N минут назад» и дать кнопку обновления.
///
/// Ещё одна причина хранить: на склад ссылается история операций с
/// остатками. Удалённый в кабинете склад нужно уметь назвать по имени
/// и через полгода — поэтому строка не удаляется, а помечается archivedAt.
model OzonWarehouse {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  marketplaceAccountId String
  account              MarketplaceAccount @relation(fields: [marketplaceAccountId], references: [id], onDelete: Cascade)

  /// warehouse_id площадки. Наружу в интерфейс не показываем (ТЗ §6), но
  /// без него остаток не записать. BigInt, а не Int: идентификаторы Ozon
  /// шестнадцатизначные и в 32 бита не помещаются.
  warehouseId BigInt
  name        String

  /// Статус склада словами Ozon: created, disabled, blocked, error…
  /// Храним как есть: список статусов площадка меняет без предупреждения,
  /// а перевод в своё перечисление превратил бы новый статус в ошибку.
  status String?

  /// Можно ли писать остатки на этот склад. Считается из статуса при
  /// синхронизации; неизвестный статус считаем рабочим — см. правила
  /// в ozon-warehouse-rules.ts.
  isEditable Boolean @default(true)
  /// Почему нельзя — эту строку показываем рядом с выключенным пунктом,
  /// иначе человек видит недоступный склад без объяснения.
  disabledReason String?

  /// Склад пропал из ответа Ozon: его удалили в кабинете. Строку оставляем
  /// ради истории, но из выбора убираем.
  archivedAt DateTime?

  /// Когда строка последний раз подтверждена ответом площадки.
  syncedAt DateTime @default(now())

  @@unique([marketplaceAccountId, warehouseId])
  @@index([marketplaceAccountId, archivedAt])
}

/// Массовое изменение остатков Ozon: одна операция целиком.
///
/// Операция — это запись, а не действие в памяти. Так решаются сразу три
/// задачи: повторное нажатие кнопки не создаёт вторую отправку, работа
/// продолжается после закрытия вкладки, и через полгода можно ответить,
/// кто и когда поставил этот остаток.
model OzonStockBulkOperation {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  marketplaceAccountId String
  account              MarketplaceAccount @relation(fields: [marketplaceAccountId], references: [id], onDelete: Cascade)

  mode   EnumBulkStockMode   @default(SET)
  status EnumBulkStockStatus @default(PENDING)

  /// Что человек ввёл в поле «Количество». У режима «разные значения по
  /// складам» единого числа нет — тогда пусто, а значения лежат в парах.
  defaultQuantity Int?

  productCount   Int @default(0)
  warehouseCount Int @default(0)
  operationCount Int @default(0)
  successCount   Int @default(0)
  errorCount     Int @default(0)

  createdById String?
  createdBy   User?   @relation("BulkStockAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  startedAt   DateTime?
  completedAt DateTime?

  /// Ошибка, из-за которой встала вся операция (не отдельная пара).
  lastError String?

  items OzonStockBulkOperationItem[]

  @@index([marketplaceAccountId, createdAt])
  @@index([status])
}

/// Одна пара «товар × склад» внутри операции.
///
/// Отдельная строка на пару, а не на товар: у Ozon один товар на трёх
/// складах — это три независимых изменения, и отказать площадка может
/// по любому из них поодиночке.
model OzonStockBulkOperationItem {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  operationId String
  operation   OzonStockBulkOperation @relation(fields: [operationId], references: [id], onDelete: Cascade)

  /// Артикул продавца. Регистр значим — offer_id у Ozon регистрозависим.
  offerId String
  /// Внутренний номер товара в Ozon, если он известен на момент отправки.
  ozonProductId BigInt?

  warehouseId BigInt
  /// Имя склада на момент операции. Копия, а не ссылка: склад могут
  /// переименовать или удалить, а в истории он должен остаться собой.
  warehouseName String

  requestedQuantity Int
  /// Остаток до изменения, если удалось его узнать. Для режима «Добавить»
  /// это основа расчёта, для «Установить» — просто справка в отчёте.
  previousStock Int?
  /// Что в итоге отправили площадке. У «Установить» совпадает
  /// с requestedQuantity, у «Добавить» — previousStock + requestedQuantity.
  calculatedStock Int?

  status     EnumBulkStockItemStatus @default(PENDING)
  attempts   Int                     @default(0)
  /// Когда пару последний раз отправляли. Ozon разрешает трогать одну пару
  /// не чаще раза в тридцать секунд, и без этой отметки повтор ошибок
  /// уходил бы в запрещённое окно и получал отказ второй раз подряд.
  lastSentAt DateTime?

  errorCode    String?
  errorMessage String?

  @@unique([operationId, offerId, warehouseId])
  @@index([operationId, status])
}

enum EnumBulkStockMode {
  /// Поставить конечное количество. Основной режим.
  SET
  /// Прибавить к текущему. Атомарного increment у Ozon нет, поэтому
  /// значение вычисляется у нас перед самой отправкой.
  ADD
}

enum EnumBulkStockStatus {
