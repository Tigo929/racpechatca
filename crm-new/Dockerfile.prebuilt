FROM node:22-alpine AS build
WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY nest-cli.json tsconfig*.json ./
COPY prisma ./prisma
COPY prisma.config.ts ./prisma.config.ts
COPY src ./src

RUN DATABASE_URL=postgresql://crm_user:crm_password@postgres:5432/crm npx prisma generate
RUN npm run build

FROM node:22-alpine
WORKDIR /app

# Идентификатор сборки (этап 13, раздел 20): CI передаёт хеш коммита, /health
# отвечает им же, а auto-update сверяет метку образа с ответом /health —
# так видно, какая сборка реально работает. Значение по умолчанию — «unknown»,
# чтобы локальная сборка без аргумента тоже собиралась.
ARG BUILD_SHA=unknown
ENV BUILD_SHA=$BUILD_SHA
LABEL org.opencontainers.image.revision=$BUILD_SHA       org.opencontainers.image.source=https://github.com/Tigo929/racpechatca

# Шрифты для листа согласования: sharp рисует текст через SVG, а в alpine
# шрифтов нет вовсе — без них кириллица станет пустыми квадратами.
# poppler-utils — растеризация PDF-макетов в генераторе карточек Ozon.
RUN apk add --no-cache fontconfig ttf-dejavu poppler-utils && fc-cache -f

COPY package*.json ./
RUN npm ci --omit=dev

COPY prisma ./prisma
COPY prisma.config.ts ./prisma.config.ts
COPY --from=build /app/dist ./dist
COPY --from=build /app/src/generated ./src/generated

EXPOSE 3000
CMD ["node", "dist/src/main"]
