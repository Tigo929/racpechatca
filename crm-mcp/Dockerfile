# MCP-сервер над CRM. Нужен, когда агент живёт не на ноутбуке владельца,
# а рядом с остальными контейнерами: тогда сервер поднимается с PORT и
# слушает внутреннюю сеть.
#
# Сборка в два этапа: в готовый образ не попадают ни TypeScript, ни tsx,
# ни тесты — только собранный код и рабочие зависимости.
FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm ci
COPY tsconfig.json ./
COPY src ./src
RUN npm run build

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production
COPY package.json package-lock.json* ./
RUN npm ci --omit=dev && npm cache clean --force
COPY --from=build /app/dist ./dist

# Не root: серверу нужно только соединение с базой на чтение.
USER node

# PORT намеренно НЕ задан: без него сервер поднимается в stdio, а это
# основной способ подключения — агент запускает контейнер разово через
# `docker run -i` (в том числе по SSH), протокол идёт по стандартному вводу,
# и ни одного порта не открывается.
#
# Сначала здесь стояло ENV PORT=3333, и из-за этого контейнер молча
# поднимался в HTTP, а агент, ждавший stdio, не получал ни одного ответа.
# Значение по умолчанию выбирало режим за того, кто запускает, — так нельзя.
#
# HTTP включается явно: `docker run -e PORT=3333 -e HOST=0.0.0.0`. 0.0.0.0
# там — это сеть докера, а не интернет: иначе соседний контейнер до сервера
# не дотянется. Порт наружу публиковать НЕ нужно, доступ к нему равен
# доступу ко всей базе CRM на чтение — в compose оставляйте сервис без
# `ports:`, агент обращается по имени сервиса.
EXPOSE 3333

CMD ["node", "dist/index.js"]
