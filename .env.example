# Скопируй этот файл в .env и заполни
DB_PASSWORD=придумай_сложный_пароль_123
JWT_SECRET=придумай_длинный_секрет_для_токенов_abc

# Секрет для приёма заявок с сайта фотопечати.
# Тот же секрет указать на сайте как CRM_WEBHOOK_TOKEN.
CRM_LEAD_TOKEN=придумай_длинный_секрет_для_заявок_с_сайта
# Секрет подписи заявок с сайта (HMAC-SHA256 по «метка_времени.тело»).
# Должен совпадать с CRM_WEBHOOK_SIGNING_SECRET на сайте.
CRM_LEAD_SIGNING_SECRET=
# true — заявки без подписи отклоняются. Включать ПОСЛЕ того, как сайт
# начал подписывать: иначе приём заявок встанет.
CRM_LEAD_REQUIRE_SIGNATURE=false

# Telegram-уведомления рабочей группе
TELEGRAM_BOT_TOKEN=
TELEGRAM_GROUP_CHAT_ID=
# Напоминания «Пора попросить отзыв» — в отдельный чат/тему форума.
# CHAT_ID берётся из ссылки t.me/c/<X>/<Y> как -100<X>; THREAD_ID = <Y> (id темы).
# Если оставить пустыми — напоминания уходят в TELEGRAM_GROUP_CHAT_ID.
TELEGRAM_REVIEW_CHAT_ID=
TELEGRAM_REVIEW_THREAD_ID=
# Секрет webhook Telegram-кнопок. Любая длинная случайная строка.
TELEGRAM_WEBHOOK_SECRET=

# ── Интеграция с исполнителем-партнёром (печать футболок) ──────────────────
# Сейчас рабочий поток идёт через Telegram: при переводе футболочного заказа
# в «Отправлен» CRM отправляет ТЗ-файл и подробное описание в чат исполнителя.
TSHIRT_PARTNER_TELEGRAM_CHAT_ID=
TSHIRT_PARTNER_TELEGRAM_THREAD_ID=
#
# Старый обмен с CRM партнёра оставлен выключенным до отдельного решения.
# Куда мы шлём заказ (вебхук партнёра) и наш токен для него:
PARTNER_WEBHOOK_ENABLED=false
PARTNER_WEBHOOK_URL=
PARTNER_WEBHOOK_TOKEN=
PARTNER_STATUS_POLL_ENABLED=false
# Токен, которым партнёр авторизуется у нас (забирает заказ/ТЗ-фото/стикер):
PARTNER_API_TOKEN=
# Публичный адрес нашего API для ссылок на файлы в вебхуке:
PUBLIC_BASE_URL=
# Каталог хранения ТЗ-фото (в контейнере — том /app/uploads):
UPLOAD_DIR=/app/uploads

# ── Avito API ──────────────────────────────────────────────────────────────
# Ключи из кабинета developers.avito.ru. Пусто — клиент не настроен, CRM
# работает как обычно. Чтение отзывов и профиля доступно на бесплатном
# тарифе; переписка (мессенджер) требует платного.
AVITO_CLIENT_ID=
AVITO_CLIENT_SECRET=
# Автосинхронизация диалогов Avito. Для локальной разработки можно оставить false
# и нажимать «Синхронизировать» в интерфейсе вручную.
AVITO_MESSENGER_POLLING_ENABLED=false
AVITO_MESSENGER_POLLING_INTERVAL_MS=60000
